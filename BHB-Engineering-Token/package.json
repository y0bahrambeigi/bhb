{
  "name": "bhb-engineering-token",
  "version": "1.1.0",
  "private": true,
  "description": "BHB Engineering Token ERC-20 prototype for the Ethereum Sepolia testnet",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "hardhat build",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "test:deployment": "node tools/test-deployment-config.mjs",
    "coverage": "hardhat test --coverage",
    "audit:ci": "npm audit --audit-level=moderate",
    "deploy:local": "hardhat ignition deploy ignition/modules/BHBEngineeringTokenLocal.ts",
    "preflight:sepolia": "hardhat run tools/preflight-sepolia-safe.ts --network sepolia",
    "deploy:sepolia": "npm run preflight:sepolia && hardhat ignition deploy ignition/modules/BHBEngineeringToken.ts --network sepolia --parameters ignition/parameters/sepolia.json",
    "deploy:sepolia:safe": "npm run deploy:sepolia",
    "verify:sepolia": "npm run preflight:sepolia && hardhat ignition deploy ignition/modules/BHBEngineeringToken.ts --network sepolia --parameters ignition/parameters/sepolia.json --verify",
    "verify:sepolia:safe": "npm run verify:sepolia",
    "sync:sepolia": "node tools/sync-deployment-address.mjs",
    "multisig:calldata": "node tools/prepare-multisig-calldata.mjs",
    "dashboard": "node tools/serve-dashboard.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/safe-deployments": "1.37.56",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "26.2.0",
    "ethers": "6.17.0",
    "hardhat": "3.14.0",
    "solc": "0.8.28",
    "typescript": "7.0.2"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.1.0",
    "tmp": "0.2.7"
  }
}
