{
  "name": "rasa-cell-offline",
  "version": "1.0.0",
  "private": true,
  "description": "RASA-Cell interactive construction simulator — offline PWA, Android, iOS and Windows",
  "author": "Yousef Bahram Beigi",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:web": "vite build && node scripts/generate-sw.mjs",
    "build:deploy": "npm run build:web && node scripts/sync-deploy.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:offline": "node scripts/offline-audit.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run test && npm run build:web && npm run test:offline",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build:web && npx cap sync",
    "electron": "npm run build:web && electron .",
    "dist:windows": "npm run build:web && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/estedad": "5.3.0",
    "@fontsource/lalezar": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.0.0",
    "playwright": "1.62.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "ir.ybb.rasacell",
    "productName": "RASA Cell",
    "asar": true,
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "RASA-Cell-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RASA Cell"
    }
  }
}
